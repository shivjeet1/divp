# =====================================================================
# Decentralized Identity Verification Pipeline - environment template
# Copy to `.env` and fill in values. NEVER commit the real .env file.
# =====================================================================

APP_NAME=Decentralized Identity
NODE_ENV=development

# --- URLs -------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
# Documentation / visualization portal (apps/docs, Vite). Started by ./start.sh.
DOCS_URL=http://localhost:5173

# --- Database ---------------------------------------------------------
# docker-compose.yml provides this exact database.
DATABASE_URL=postgresql://divp:divp_password@localhost:5432/decentralized_identity

# --- Blockchain -------------------------------------------------------
# Ganache (npm run chain). Read the real values from the running node;
# backend startup cross-checks CHAIN_ID against the RPC endpoint.
RPC_URL=http://127.0.0.1:7545
CHAIN_ID=1337
# Filled in by `npm run deploy:contract` (also written to contracts/deployment.json)
IDENTITY_CONTRACT_ADDRESS=

# --- JWT --------------------------------------------------------------
# Generate with: npm run gen:secret   (48 random bytes, base64url)
# A value is required for the backend to start (fail closed).
JWT_SECRET=
JWT_ISSUER=identity-auth-server
JWT_AUDIENCE=identity-web-app
# Session lifetime in seconds (default 3600)
JWT_TTL_SECONDS=3600

# --- SIWE -------------------------------------------------------------
SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000
SIWE_STATEMENT=Sign in to the Decentralized Identity Verification Pipeline.
# Maximum accepted age of a SIWE message / nonce lifetime, seconds
NONCE_TTL_SECONDS=300
SIWE_MAX_AGE_SECONDS=300
# Allowed clock skew when validating Issued At, seconds
CLOCK_SKEW_SECONDS=60

# --- Security ---------------------------------------------------------
# Comma separated CORS allowlist (must NOT be `*` with credentials)
CORS_ORIGINS=http://localhost:3000
# Secure cookie flag. Explicit value always wins. If left unset/empty the
# default is environment-aware: secure when NODE_ENV=production (never
# silently insecure), insecure in dev (browsers reject Secure cookies over
# plain http://localhost).
COOKIE_SECURE=false
COOKIE_NAME=divp_session
COOKIE_MAX_AGE_SECONDS=3600
# Rate limits (requests per window per key)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_GENERAL_MAX=300
# Re-check the IdentityRegistry contract on every authenticated request.
# A wallet revoked on-chain immediately loses its server session (fail closed).
SESSION_RECHECK_ONCHAIN=true

# --- Admin API (optional endpoints /admin/identities) -----------------
# The backend signs IdentityRegistry admin transactions with this key.
# Local-dev value: private key of account #0 derived from the deterministic
# Ganache mnemonic (`test test ... junk`) - a PUBLICLY KNOWN test key, not a
# secret. Leave empty to disable the admin write endpoints (fail closed).
# In production this would be a dedicated, HSM-backed operator key.
ADMIN_PRIVATE_KEY=
