// Decentralized Identity Verification Pipeline - PostgreSQL schema.
// Managed from the repository root:
//   npm run db:migrate   (prisma migrate dev --schema prisma/schema.prisma)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Application-level wallet identity metadata (authorization itself lives
/// on-chain in IdentityRegistry; this table only tracks local metadata).
/// Sessions and audit logs reference `walletAddress` directly so that events
/// for unknown/revoked wallets can still be recorded.
model User {
  id            String   @id @default(uuid())
  walletAddress String   @unique @db.VarChar(42) // stored lower-cased
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([walletAddress])
}

/// Single-use authentication nonce lifecycle.
model Nonce {
  id            String    @id @default(uuid())
  walletAddress String    @db.VarChar(42) // lower-cased, wallet-bound
  value         String    @unique @db.VarChar(64)
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  usedAt        DateTime?

  @@index([walletAddress])
  @@index([expiresAt])
  @@index([walletAddress, usedAt])
}

/// Server-side session record (JWT carries the same JTI).
model Session {
  id            String    @id @default(uuid())
  jti           String    @unique @db.VarChar(64)
  walletAddress String    @db.VarChar(42) // lower-cased
  role          String    @db.VarChar(16)
  issuedAt      DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  userAgent     String?   @db.VarChar(512)
  ipAddress     String?   @db.VarChar(64)
  updatedAt     DateTime  @updatedAt

  @@index([walletAddress])
  @@index([expiresAt])
  @@index([revokedAt])
}

/// Append-only security audit trail. Never stores secrets.
model AuditLog {
  id            String   @id @default(uuid())
  walletAddress String?  @db.VarChar(42) // lower-cased when known
  event         String   @db.VarChar(64)
  timestamp     DateTime @default(now())
  ipAddress     String?  @db.VarChar(64)
  userAgent     String?  @db.VarChar(512)
  metadata      Json?

  @@index([timestamp])
  @@index([event])
  @@index([walletAddress])
}
